---
import Layout from '../../layouts/Layout.astro';
import {projects} from '../../data/profile';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project:p}=Astro.props;const base=import.meta.env.BASE_URL;
---
<Layout title={`${p.title} — Krishna Prasad Namala`} description={p.summary}><article class="wrap case"><a class="text-link" href={`${base}#work`}>&#8592; Selected work</a><span class="eyebrow">{p.industry} / CASE STUDY {p.number}</span><h1>{p.title}</h1><p class="case-lead">{p.summary}</p><div class="tags">{p.tech.map(t=><span>{t}</span>)}</div><div class="case-body">{[['The challenge',p.challenge],['Contribution',p.contribution],['How the solution works',p.solution],['Engineering consideration',p.consideration],['Qualitative outcome',p.outcome]].map(([title,copy])=><section><h2>{title}</h2><p>{copy}</p></section>)}</div><aside class="disclosure">Anonymized account grounded in resume-supported experience. Architectural explanations are conceptual illustrations; no client system, records, or proprietary implementation is shown.</aside><a class="button" href={`${base}#work`}>Explore more work &#8599;</a></article></Layout>
