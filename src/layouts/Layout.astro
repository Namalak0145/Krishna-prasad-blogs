---
import '../styles/global.css';
import {profile} from '../data/profile';
const {title = 'Krishna Prasad Namala — Senior Full Stack .NET Developer',description='Enterprise applications, connected services, and thoughtful engineering with C#, .NET, Angular, and Azure.'}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#080D0B"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={new URL(`${base}social.svg`,Astro.site).href}/><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/><title>{title}</title></head><body><a class="skip" href="#main">Skip to content</a><div class="progress" aria-hidden="true"></div><header><a class="brand" href={base} aria-label="Krishna Prasad Namala home"><span class="mark">K<span>•</span></span><span>KRISHNA PRASAD<br/><small>FULL STACK ENGINEER</small></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation" hidden>Menu</button><nav id="navigation" aria-label="Main navigation">{['Work','Skills','Approach','Journey','Contact'].map(label=><a href={`${base}#${label.toLowerCase()}`}>{label}</a>)}</nav><button id="effects" aria-pressed="false" hidden>Effects: off</button></header><main id="main"><slot/></main><footer><a href={base}>{profile.name}</a><span>Built with purpose. Connected by design.</span><a href="#main">Back to top &#8593;</a></footer><div class="cursor" aria-hidden="true"></div><script>
const root=document.documentElement;const reduce=matchMedia('(prefers-reduced-motion: reduce)');const fine=matchMedia('(pointer:fine)');const effects=document.querySelector<HTMLButtonElement>('#effects')!;let enabled=!reduce.matches;const apply=()=>{root.classList.toggle('effects',enabled&&!reduce.matches);effects.textContent=`Effects: ${enabled&&!reduce.matches?'on':'off'}`;effects.setAttribute('aria-pressed',String(enabled&&!reduce.matches));};effects.hidden=false;apply();effects.onclick=()=>{enabled=!enabled;apply();};reduce.addEventListener('change',apply);document.addEventListener('visibilitychange',()=>root.classList.toggle('paused',document.hidden));const cursor=document.querySelector<HTMLElement>('.cursor')!;window.addEventListener('pointermove',e=>{if(fine.matches&&enabled&&!reduce.matches){cursor.style.transform=`translate(${e.clientX}px,${e.clientY}px)`;}},{passive:true});const progress=document.querySelector<HTMLElement>('.progress')!;const update=()=>{const total=document.documentElement.scrollHeight-innerHeight;progress.style.width=`${total>0?Math.min(100,Math.max(0,scrollY/total*100)):0}%`;const current=(scrollY+innerHeight>=document.documentElement.scrollHeight-3&&document.getElementById('contact'))?'contact':['work','skills','approach','journey','contact'].filter(id=>(document.getElementById(id)?.getBoundingClientRect().top??Infinity)<=150).at(-1);document.querySelectorAll('nav a').forEach(a=>{if(current&&a.getAttribute('href')?.endsWith('#'+current))a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});};window.addEventListener('scroll',update,{passive:true});window.addEventListener('resize',update);update();const menu=document.querySelector<HTMLButtonElement>('.menu-toggle')!;const nav=document.querySelector<HTMLElement>('nav')!;menu.hidden=false;const close=()=>{nav.classList.remove('open');menu.setAttribute('aria-expanded','false');menu.textContent='Menu';};menu.onclick=()=>{const open=nav.classList.toggle('open');menu.setAttribute('aria-expanded',String(open));menu.textContent=open?'Close ×':'Menu';if(open)nav.querySelector('a')?.focus();};nav.addEventListener('click',close);document.addEventListener('keydown',e=>{if(e.key==='Escape'&&nav.classList.contains('open')){close();menu.focus();}if(e.key==='Tab'&&nav.classList.contains('open')){const links=Array.from(nav.querySelectorAll('a'));if(!e.shiftKey&&document.activeElement===links.at(-1)){e.preventDefault();menu.focus();}else if(e.shiftKey&&document.activeElement===menu){e.preventDefault();links.at(-1)?.focus();}}});const observer=new IntersectionObserver(entries=>entries.forEach(e=>{e.target.classList.toggle('in-view',e.isIntersecting);}),{rootMargin:'-10% 0px -25% 0px'});document.querySelectorAll('section,.flow-art,#approach').forEach(s=>observer.observe(s));
</script></body></html>
